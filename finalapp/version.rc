#include <winver.h>

1 ICON "app_icon.ico"

1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Dota Drafter"
      VALUE "FileDescription",  "Dota 2 Draft Assistant — hero pick recommendations"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "Dota_Drafter"
      VALUE "LegalCopyright",   "Copyright (c) 2025 Dota Drafter"
      VALUE "OriginalFilename", "Dota_Drafter.exe"
      VALUE "ProductName",      "Dota Drafter"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

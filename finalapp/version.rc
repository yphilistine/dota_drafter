#include <winver.h>

#ifndef VER_MAJOR
#define VER_MAJOR 1
#endif
#ifndef VER_MINOR
#define VER_MINOR 0
#endif
#ifndef VER_PATCH
#define VER_PATCH 0
#endif
#ifndef VER_BUILD
#define VER_BUILD 0
#endif

#define S2(x) #x
#define S(x)  S2(x)
#define VER_STR S(VER_MAJOR) "." S(VER_MINOR) "." S(VER_PATCH) "." S(VER_BUILD)

1 ICON "app_icon.ico"

1 VERSIONINFO
FILEVERSION    VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Dota Drafter"
      VALUE "FileDescription",  "Dota 2 Draft Assistant \x2014 hero pick recommendations"
      VALUE "FileVersion",      VER_STR
      VALUE "InternalName",     "Dota_Drafter"
      VALUE "LegalCopyright",   "Copyright (c) 2025 Dota Drafter"
      VALUE "OriginalFilename", "Dota_Drafter.exe"
      VALUE "ProductName",      "Dota Drafter"
      VALUE "ProductVersion",   VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
